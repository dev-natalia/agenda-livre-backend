# Copie este arquivo para `.env` e preencha os valores reais.
# O arquivo `.env` NAO e versionado. Nunca coloque segredos reais neste arquivo de exemplo.

# --- Aplicacao ---
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Banco de dados (PostgreSQL no AWS RDS) ---
DB_HOST=seu-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=nome_do_banco
DB_USER=usuario_do_banco
DB_PASSWORD=senha_do_banco
# Modos: disable, allow, prefer, require, verify-ca, verify-full (padrao: require)
DB_SSLMODE=require
# Caminho do certificado raiz da AWS (usado com verify-ca ou verify-full)
DB_SSLROOTCERT=

# --- Frontend (repositorio separado) ---
# Origens permitidas, separadas por virgula. Vazio = nenhuma origem autorizada.
CORS_ALLOWED_ORIGINS=http://localhost:5500
