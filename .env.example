# Copie este arquivo para `.env` e preencha os valores reais.
# O arquivo `.env` NAO e versionado. Nunca coloque segredos reais neste arquivo de exemplo.

# --- Aplicacao ---
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Redireciona para HTTPS, usa cookies seguros e HSTS. Padrao: ligado quando DJANGO_DEBUG=False.
# Em HTTP local com DJANGO_DEBUG=False, use False (senao o login do painel nao persiste).
DJANGO_HTTPS_ONLY=False

# --- Banco de dados (PostgreSQL no AWS RDS) ---
DB_HOST=seu-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=nome_do_banco
DB_USER=usuario_do_banco
DB_PASSWORD=senha_do_banco
# Modos: disable, allow, prefer, require, verify-ca, verify-full (padrao: require)
DB_SSLMODE=require
# Caminho do certificado raiz da AWS (usado com verify-ca ou verify-full)
DB_SSLROOTCERT=

# --- Frontend (repositorio separado) ---
# Origens permitidas, separadas por virgula. Vazio = nenhuma origem autorizada.
CORS_ALLOWED_ORIGINS=http://localhost:5500

# --- Registro de erros (arquivo local) ---
# Pasta dos registros (relativa a raiz do repositorio ou caminho absoluto). Nao e versionada.
LOG_DIR=logs
# Nivel minimo gravado: WARNING, ERROR ou CRITICAL.
LOG_LEVEL=ERROR
# Tamanho maximo de cada arquivo (bytes) e quantidade de arquivos antigos mantidos.
LOG_MAX_BYTES=1048576
LOG_BACKUP_COUNT=5

# --- Imagens das atividades (Amazon S3) ---
# Usuário IAM da aplicação (somente PutObject, GetObject, DeleteObject e ListBucket no bucket).
# A chave secreta nunca vai para o repositório nem para os logs.
AWS_ACCESS_KEY_ID=chave-de-acesso-AWS
AWS_SECRET_ACCESS_KEY=chave-secreta-AWS
AWS_STORAGE_BUCKET_NAME=nome-do-bucket-AWS
AWS_S3_REGION_NAME=regiao-bucket-AWS